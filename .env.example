# ==============================================================================
# Environment Configuration Template (Do NOT commit real production credentials)
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Application Security & Sessions
SECRET_KEY=replace_with_a_64_byte_random_cryptographic_secret_key_in_production
SESSION_COOKIE_NAME=student_success_session
CSRF_COOKIE_NAME=student_success_csrf
SESSION_MAX_AGE_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allowed CORS Origins (Frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection
# Local PostgreSQL Development Cluster (Port 5433)
DATABASE_URL=postgresql://postgres@localhost:5433/student_success
# Application user for Row-Level Security least-privilege verification:
APP_DB_USER=app_user
APP_DB_PASSWORD=replace_with_secure_app_user_password

# Offline SQLite Development Fallback (if PostgreSQL service is completely offline):
SQLITE_FALLBACK_URL=sqlite:///./student_success.db

# Machine Learning & UCI Dataset
UCI_DATASET_URL=https://archive.ics.uci.edu/static/public/697/predict+students+dropout+and+academic+success.zip
MODEL_ARTIFACTS_DIR=./app/ml/artifacts

# Rate Limiting Controls
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PREDICTION_PER_MINUTE=60
RATE_LIMIT_GLOBAL_PER_MINUTE=300
